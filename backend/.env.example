# Copy this file to .env and adjust if you do not use Docker
# Prisma uses this to connect to Postgres
# Matches docker-compose.yml (postgres forwarded to localhost:5440)
DATABASE_URL="postgresql://postgres:postgres@localhost:5440/ai_trends?schema=public"

# JWT secret for local dev
JWT_SECRET="dev_secret"

# Nest app port (optional)
PORT=3000
